{
  "name": "HiroToDo",
  "description": "Une Todo-List / Des notes",
  "version": "1.0",
  "manifest_version": 3,
    "icons": {
    "16": "icon/icon16.png",
    "32": "icon/icon32.png",
    "48": "icon/icon48.png",
    "128": "icon/icon128.png"
  },
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": [
    "scripting",
    "activeTab",
    "notifications",
    "storage",
    "alarms",
    "downloads"
  ]
}
